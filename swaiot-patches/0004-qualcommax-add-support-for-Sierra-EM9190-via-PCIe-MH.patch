From 7f9ed89924da687bc76d73e98da09403ff4c1e17 Mon Sep 17 00:00:00 2001
From: ghoker143 <ghoker51@protonmail.com>
Date: Sun, 9 Aug 2026 21:32:19 +0800
Subject: [PATCH 4/6] qualcommax: add EM9190 PCIe/MHI support (QMI-only)

---
 .../999-mhi-em9190-sierra-nombim.patch        | 69 +++++++++++++++++++
 1 file changed, 69 insertions(+)
 create mode 100644 target/linux/qualcommax/patches-6.12/999-mhi-em9190-sierra-nombim.patch

diff --git a/target/linux/qualcommax/patches-6.12/999-mhi-em9190-sierra-nombim.patch b/target/linux/qualcommax/patches-6.12/999-mhi-em9190-sierra-nombim.patch
new file mode 100644
index 0000000..545032a
--- /dev/null
+++ b/target/linux/qualcommax/patches-6.12/999-mhi-em9190-sierra-nombim.patch
@@ -0,0 +1,69 @@
+--- a/drivers/bus/mhi/host/pci_generic.c
++++ b/drivers/bus/mhi/host/pci_generic.c
+@@ -614,6 +614,51 @@
+ 	.sideband_wake = false,
+ };
+ 
++/* Swaiot M01M variant: Sierra EM9190 with GENERIC firmware (17cb:010c).
++ * Same channel layout as sierra-em919x but without the MBIM control
++ * channels (12/13).  Opening the MBIM channel makes this firmware switch
++ * its QMI WDA data aggregation to MBIM mode (persistent until modem
++ * reset), which breaks QMI raw-ip setups and has been linked to random
++ * firmware crashes.  Not exposing the channel keeps the modem on the
++ * plain QMI/raw-ip path. */
++static const struct mhi_channel_config mhi_sierra_em919x_nombim_channels[] = {
++	MHI_CHANNEL_CONFIG_UL_SBL(2, "SAHARA", 32, 0),
++	MHI_CHANNEL_CONFIG_DL_SBL(3, "SAHARA", 256, 0),
++	MHI_CHANNEL_CONFIG_UL(4, "DIAG", 32, 0),
++	MHI_CHANNEL_CONFIG_DL(5, "DIAG", 32, 0),
++	MHI_CHANNEL_CONFIG_UL(14, "QMI", 32, 0),
++	MHI_CHANNEL_CONFIG_DL(15, "QMI", 32, 0),
++	MHI_CHANNEL_CONFIG_UL(32, "DUN", 32, 0),
++	MHI_CHANNEL_CONFIG_DL(33, "DUN", 32, 0),
++	MHI_CHANNEL_CONFIG_HW_UL(100, "IP_HW0", 512, 1),
++	MHI_CHANNEL_CONFIG_HW_DL(101, "IP_HW0", 512, 2),
++};
++
++static struct mhi_event_config modem_sierra_em919x_nombim_mhi_events[] = {
++	/* first ring is control+data and DIAG ring */
++	MHI_EVENT_CONFIG_CTRL(0, 2048),
++	/* Hardware channels request dedicated hardware event rings */
++	MHI_EVENT_CONFIG_HW_DATA(1, 2048, 100),
++	MHI_EVENT_CONFIG_HW_DATA(2, 2048, 101)
++};
++
++static const struct mhi_controller_config modem_sierra_em919x_nombim_config = {
++	.max_channels = 128,
++	.timeout_ms = 24000,
++	.num_channels = ARRAY_SIZE(mhi_sierra_em919x_nombim_channels),
++	.ch_cfg = mhi_sierra_em919x_nombim_channels,
++	.num_events = ARRAY_SIZE(modem_sierra_em919x_nombim_mhi_events),
++	.event_cfg = modem_sierra_em919x_nombim_mhi_events,
++};
++
++static const struct mhi_pci_dev_info mhi_sierra_em919x_nombim_info = {
++	.name = "sierra-em919x-nombim",
++	.config = &modem_sierra_em919x_nombim_config,
++	.bar_num = MHI_PCI_DEFAULT_BAR_NUM,
++	.dma_data_width = 32,
++	.sideband_wake = false,
++};
++
+ static const struct mhi_channel_config mhi_telit_fn980_hw_v1_channels[] = {
+ 	MHI_CHANNEL_CONFIG_UL(14, "QMI", 32, 0),
+ 	MHI_CHANNEL_CONFIG_DL(15, "QMI", 32, 0),
+@@ -781,8 +826,13 @@
+ 		.driver_data = (kernel_ulong_t) &mhi_telit_fn920c04_info },
+ 	{ PCI_DEVICE(PCI_VENDOR_ID_QCOM, 0x0304),
+ 		.driver_data = (kernel_ulong_t) &mhi_qcom_sdx24_info },
++	/* Sierra Wireless EM9190 with GENERIC firmware reports same
++	 * subsystem ID as Foxconn SDX55 (17cb:010c). Use sierra_em919x
++	 * derived config (3 event rings, 4 MSI) to avoid broken 5th MSI
++	 * vector on GICv2m platforms (e.g. IPQ807x), without MBIM
++	 * channels (see above). */
+ 	{ PCI_DEVICE_SUB(PCI_VENDOR_ID_QCOM, 0x0306, PCI_VENDOR_ID_QCOM, 0x010c),
+-		.driver_data = (kernel_ulong_t) &mhi_foxconn_sdx55_info },
++		.driver_data = (kernel_ulong_t) &mhi_sierra_em919x_nombim_info },
+ 	/* EM919x (sdx55), use the same vid:pid as qcom-sdx55m */
+ 	{ PCI_DEVICE_SUB(PCI_VENDOR_ID_QCOM, 0x0306, 0x18d7, 0x0200),
+ 		.driver_data = (kernel_ulong_t) &mhi_sierra_em919x_info },
-- 
2.54.0

